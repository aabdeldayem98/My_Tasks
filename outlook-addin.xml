<?xml version="1.0" encoding="UTF-8"?>
<!--
  North Star — Outlook add-in (manifest)
  Add it in Outlook on the web: https://aka.ms/olksideload → My add-ins → Add a custom add-in → Add from file.
  It opens https://aabdeldayem98.github.io/My_Tasks/ in a side pane next to your email.
  If you ever move the app to another address, change the 4 links below that start with https://aabdeldayem98.github.io
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>7c084a9c-e629-4876-90e5-67412dedd7ef</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Ahmed Abdel-Dayem</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="North Star"/>
  <Description DefaultValue="Your tasks, Focus Hub, projects and Gantt chart next to your email. Turn any email into a task in one click."/>
  <IconUrl DefaultValue="https://aabdeldayem98.github.io/My_Tasks/icons/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://aabdeldayem98.github.io/My_Tasks/icons/icon-128.png"/>
  <SupportUrl DefaultValue="https://www.linkedin.com/in/aabdel-dayem"/>
  <AppDomains>
    <AppDomain>https://aabdeldayem98.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://aabdeldayem98.github.io/My_Tasks/?host=outlook"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="myTasksGroup">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="myTasksButton">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://aabdeldayem98.github.io/My_Tasks/icons/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://aabdeldayem98.github.io/My_Tasks/icons/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://aabdeldayem98.github.io/My_Tasks/icons/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://aabdeldayem98.github.io/My_Tasks/?host=outlook"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="North Star"/>
        <bt:String id="Button.Label" DefaultValue="North Star"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Button.Tooltip" DefaultValue="Open North Star next to this email. Use “From email” to turn it into a task."/>
      </bt:LongStrings>
    </Resources>

    <!-- Newer Outlook: same button, and the pane can stay pinned while you move between emails -->
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="myTasksGroup">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="myTasksButton">
                    <Label resid="Button.Label"/>
                    <Supertip>
                      <Title resid="Button.Label"/>
                      <Description resid="Button.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16"/>
                      <bt:Image size="32" resid="Icon.32"/>
                      <bt:Image size="80" resid="Icon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="https://aabdeldayem98.github.io/My_Tasks/icons/icon-16.png"/>
          <bt:Image id="Icon.32" DefaultValue="https://aabdeldayem98.github.io/My_Tasks/icons/icon-32.png"/>
          <bt:Image id="Icon.80" DefaultValue="https://aabdeldayem98.github.io/My_Tasks/icons/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Taskpane.Url" DefaultValue="https://aabdeldayem98.github.io/My_Tasks/?host=outlook"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="North Star"/>
          <bt:String id="Button.Label" DefaultValue="North Star"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Button.Tooltip" DefaultValue="Open North Star next to this email. Use “From email” to turn it into a task."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
